# Server
PORT=4000
NODE_ENV=development

# MongoDB connection string. For local dev, run Mongo via Docker or use MongoDB Atlas free tier.
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# Secret used to sign the session cookie. Required in production, the
# server refuses to start without it when NODE_ENV=production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# The deployed frontend's origin, for CORS with credentials. Not needed
# for the CLI batch command, which never goes through Express.
FRONTEND_ORIGIN=http://localhost:3000

# More variables (LLM provider key, search API key) will be added
# here as we build those stages, deliberately not inventing them yet.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-3.5-flash-lite